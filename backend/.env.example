# 环境配置示例
# 复制此文件为 .env 并填入实际值

# ==================== LLM配置 ====================
# LLM提供商: openai / azure / zhipu / deepseek
LLM_PROVIDER=openai

# API密钥
LLM_API_KEY=your-api-key-here

# API地址
LLM_BASE_URL=https://api.openai.com/v1

# 模型名称
LLM_MODEL=gpt-4

# 温度参数 (0.0-1.0, 越低越确定)
LLM_TEMPERATURE=0.1

# ==================== 向量数据库 ====================
VECTOR_DB_PATH=./data/vector_store
EMBEDDING_MODEL=text-embedding-3-small

# ==================== 应用配置 ====================
# 服务端口
APP_HOST=0.0.0.0
APP_PORT=8000

# 日志级别
LOG_LEVEL=INFO

# 最大上传文件大小 (MB)
MAX_FILE_SIZE=50

# 支持的文件类型
ALLOWED_EXTENSIONS=pdf,docx,doc,txt

# ==================== 审查配置 ====================
# 规则文件路径
RULES_PATH=./rules

# 知识库路径
KNOWLEDGE_BASE_PATH=./knowledge_base

# 默认审查部门
DEFAULT_DEPARTMENT=investment_supervision

# ==================== CORS配置 ====================
# 允许的Origins (前端开发用)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
